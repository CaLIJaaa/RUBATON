# For an already deployed vault. For a self-contained local demo use npm run demo.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
VAULT_ADDRESS=
RUBA_ADDRESS=
USDT_ADDRESS=
VAULT_DEPLOYMENT_BLOCK=0
# Set the actual operator EOA key; never commit .env or use demo keys with real funds.
OPERATOR_PRIVATE_KEY=
DB_PATH=data/ruba.sqlite
HOST=127.0.0.1
PORT=3001
CONFIRMATIONS=0
WITHDRAWAL_TTL_SECONDS=900
SYNC_INTERVAL_MS=2000
# ZK is the default for the new local Vault. Old deployments require explicit legacy mode.
PROOF_MODE=zk
ZK_ARTIFACTS_DIR=zk/artifacts
# Preserve this secret across operator signing-key rotation if using a deployed ZK pool.
# ZK_POOL_RECOVERY_KEY=<nonzero BN254 scalar for the existing pool>

# Admission desk. Leave empty to keep admin-only whitelist.
# The key must match setAdmissionSigner in the vault and must not be the vault owner.
ADMISSION_SIGNER_PRIVATE_KEY=
ADMISSION_DB_PATH=
ADMISSION_TTL_SECONDS=3600
# Comma separated KYC IDs that the stub provider rejects
ADMISSION_KYC_DENY=
