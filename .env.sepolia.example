# Sepolia demo only. Never print private keys or include data/ in source archives.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Persistent public manifest and private journals/keys/DBs are placed under this directory.
# Existing deployer.json {address,privateKey} is loaded, never overwritten by the launcher.
SEPOLIA_STATE_DIR=data/sepolia
ZK_ARTIFACTS_DIR=zk/artifacts
PORT=3005
# Explicit Sepolia demo confirmation depth; other public networks retain consensus finality.
SEPOLIA_CONFIRMATIONS=1
# Optional public wallet to whitelist for SWAP/ADD_LP in all three test markets.
SEPOLIA_TEST_WALLET=
# Optional fee ceilings, integer wei. Without overrides prepare reads current RPC fee data.
# SEPOLIA_MAX_FEE_PER_GAS_WEI=100000000
# SEPOLIA_MAX_TOTAL_FEE_WEI=30000000000000000
# Budget refresh requires an explicit total cap. Preview after confirming the
# shared verifier/Poseidon; dependent-contract placeholders are not real gas
# measurements. The refresh preserves signed transactions and role funding.
