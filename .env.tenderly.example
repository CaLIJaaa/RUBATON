# 1. Create a Tenderly Virtual TestNet forked from Ethereum mainnet.
# Use a unique CUSTOM Chain ID (for example 73571), not Ethereum mainnet's 1.
# 2. Copy this file to .env.tenderly and paste the Admin RPC plus your public wallet address.
TENDERLY_RPC_URL=
# Alternatively leave TENDERLY_RPC_URL blank and set this alias in foundry.toml:
TENDERLY_RPC_ENDPOINT=mainnet

# Public RPC of THE SAME fork, for MetaMask/Rabby (optional for the server).
TENDERLY_PUBLIC_RPC_URL=
# Your wallet address only. Never paste your wallet's private key.
TEST_WALLET_ADDRESS=

TENDERLY_WALLET_ETH=10
TENDERLY_WALLET_RUBA=10000
TENDERLY_WALLET_USDT=10000
TENDERLY_SEED_RUBA=1000
TENDERLY_SEED_USDT=1000
PORT=3001
